# ---- Fill in these two from Supabase: Project Settings -> API ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE

# ---- Everything below has working defaults ----

# Only matters if the game is served from a different origin than this API.
# Same-origin (the default, since this server also serves the game) skips CORS.
ALLOWED_ORIGINS=*

PORT=8787
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000

# Salts the IP hash written to the logs. Use any long random string:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
IP_SALT=change-me

# Where the game file lives. Defaults to the repo root, one level up.
# PUBLIC_DIR=..
# INDEX_FILE=toad-gone-wild-crossing.html
